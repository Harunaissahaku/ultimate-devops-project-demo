# Root-context builds (docker compose, and any Dockerfile without its own
# <Dockerfile>.dockerignore) read this file. Most services COPY ./src/<svc>
# from the repo root, so only exclude directories no root-context build uses.
#
# The frontend and cart CI builds use Dockerfile-specific ignore files instead
# (src/frontend/Dockerfile.dockerignore, src/cart/src/Dockerfile.dockerignore),
# which replace this file for those builds.
.git
.github
.claude
internal
kubernetes
test
docs
*.md
**/node_modules

# Built with their own directory as context (CI and docker-compose)
src/ad
src/product-catalog

# Not built by docker-compose, or only bind-mounted as config
src/react-native-app
src/flagd
src/grafana
src/otel-collector
src/prometheus
